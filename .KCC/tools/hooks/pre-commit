#!/bin/sh
# KCC-PRE-COMMIT v1.0.0
# KCC framework (c) 2026 Tarek Fawaz, https://tikasway.dev/kcc. Licensed under the terms in LICENSE.
#
# Installed by .KCC/tools/repo-bootstrap (--install-hook / -InstallHook).
# Runs, against the STAGED change set:
#   1. check-impl-lock --staged   (skipped with a warning if the tool is absent)
#   2. quality-gate --fast        (secrets scan of staged files)
# Exit handling per tool: 0 ok | 1 violations -> commit BLOCKED |
# 3 deferred (scanner missing) -> allowed with a warning, NOT a pass |
# 2 / other -> tool could not evaluate -> allowed with a loud warning.
# A pre-existing hook preserved as pre-commit.local runs first.
# Bypass is an explicit human action only: git commit --no-verify.

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
tools="$top/.KCC/tools"
hookdir=$(dirname "$0")

if [ -x "$hookdir/pre-commit.local" ]; then
  "$hookdir/pre-commit.local" "$@" || exit $?
fi

if [ ! -d "$tools" ]; then
  echo "kcc pre-commit: warning: $tools not found; KCC checks skipped" >&2
  exit 0
fi

# run_tool NAME "bash args" "powershell args" -> tool exit code, 127 if unavailable
run_tool() {
  name=$1
  sh_args=$2
  ps_args=$3
  if [ -f "$tools/$name.sh" ] && command -v bash >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    bash "$tools/$name.sh" --repo-root "$top" $sh_args
    return $?
  fi
  if [ -f "$tools/$name.ps1" ]; then
    for ps in pwsh powershell powershell.exe; do
      if command -v "$ps" >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        "$ps" -NoProfile -ExecutionPolicy Bypass -File "$tools/$name.ps1" -RepoRoot "$top" $ps_args
        return $?
      fi
    done
  fi
  return 127
}

blocked=0
judge() {
  label=$1
  rc=$2
  case "$rc" in
    0) ;;
    1) echo "kcc pre-commit: $label found violations - commit BLOCKED" >&2; blocked=1 ;;
    3) echo "kcc pre-commit: warning: $label deferred (required tool missing) - commit allowed, this is NOT a pass" >&2 ;;
    127) echo "kcc pre-commit: warning: $label not available - skipped" >&2 ;;
    *) echo "kcc pre-commit: WARNING: $label could not evaluate (exit $rc) - commit allowed; fix the tool/environment" >&2 ;;
  esac
}

if [ -f "$tools/check-impl-lock.sh" ] || [ -f "$tools/check-impl-lock.ps1" ]; then
  run_tool check-impl-lock "--staged" "-Staged"
  judge "check-impl-lock --staged" $?
else
  echo "kcc pre-commit: warning: check-impl-lock not present - implementation-lock check skipped" >&2
fi

run_tool quality-gate "--fast" "-Fast"
judge "quality-gate --fast" $?

if [ "$blocked" -ne 0 ]; then
  echo "kcc pre-commit: fix the findings above (or, as an explicit human decision, git commit --no-verify)" >&2
  exit 1
fi
exit 0
