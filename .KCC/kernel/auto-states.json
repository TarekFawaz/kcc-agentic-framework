{
  "schema_version": "1.0",
  "doc": "Machine-readable twin of capabilities/skills/auto.md -> State table. Consumed by tools/kcc-run. Placeholders: {input} {flags} {silent_assume} {parallel} {IDEA} {SPEC} {WAVE} {ITEM} {TOOLS} (comma list derived by kcc-run from the spec dialects; bash passes it as positional args). Args are written PowerShell-style; kcc-run.sh maps -Name to --kebab-name.",
  "exit_codes": { "pass": 0, "fail": 1, "usage": 2, "deferred": 3, "paused": 4, "suspended": 5, "stopped": 6 },
  "max_attempts": 3,
  "states": [
    { "id": 0, "name": "REPO", "scope": "run",
      "check": { "tool": "repo-bootstrap", "args": ["-Json"], "pass_when": "git=repo&commits>0|decision=skip" },
      "gate": { "all": "repo-bootstrap" } },
    { "id": 1, "name": "IDEA", "scope": "run",
      "command": "/idea-interrogator {input} {silent_assume}",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "idea"] },
      "interactive_in": ["S1"], "event": "idea-interrogation-completed" },
    { "id": 2, "name": "ROI", "scope": "run",
      "check": { "tool": "internal:roi-confidence", "min_pct": 60 },
      "gate": { "all": "roi-gate" } },
    { "id": 3, "name": "TECH", "scope": "run",
      "command": "/technical-interrogator ideation/{IDEA}",
      "check": { "tool": "internal:file-exists", "path": "ideation/{IDEA}/TechnicalDecisionBrief.md" },
      "interactive_in": ["S1"], "event": "specialist-brief-created" },
    { "id": 4, "name": "SPECIALISTS", "scope": "run",
      "command": "Run the triggered specialist interrogators for ideation/{IDEA} per auto-mode.md -> Operating scenario 1 -> Step sequence item 6 (ux-ui, security, infrastructure). {silent_assume}",
      "check": { "tool": "internal:agent-report", "expect": "specialist briefs written or 'none triggered'" },
      "interactive_in": ["S1"], "event": "specialist-brief-created" },
    { "id": 5, "name": "CONFIRM", "scope": "run", "only_in": ["S1"],
      "gate": { "S1": "confirm" } },
    { "id": 6, "name": "ARCH", "scope": "run",
      "command": "Run the architect pass for {IDEA} (CR-2) including the quality-gates catalog, then /architecture-review.",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "architecture"] },
      "event": "architecture-pass-complete" },
    { "id": 7, "name": "ARCH-GATE", "scope": "run",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "architecture"] },
      "event": "conformance-checked" },
    { "id": 8, "name": "BUDGET-0", "scope": "run",
      "command": "/token-estimate {IDEA}",
      "gate": { "S1": "budget", "S2": "none", "S3": "budget-cap" }, "event": "estimate-issued" },
    { "id": 9, "name": "SPECS", "scope": "run",
      "command": "/spec-create ideation/{IDEA}/SpecWriterStarter.md {parallel}",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "specs"] },
      "event": "spec-created" },
    { "id": 10, "name": "BUDGET-P", "scope": "spec",
      "command": "/token-estimate {SPEC}",
      "gate": { "S1": "budget", "S2": "none", "S3": "budget-cap" }, "event": "estimate-issued" },
    { "id": 11, "name": "PLAN", "scope": "spec",
      "command": "/spec-plan {SPEC}",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "plan", "-Spec", "{SPEC}"] },
      "event": "plan-created" },
    { "id": 12, "name": "WINDOWS", "scope": "spec",
      "gate": { "S1": "windows", "S2": "none", "S3": "none" }, "skip_if_flag": "parallel" },
    { "id": 13, "name": "BUDGET-I", "scope": "spec",
      "command": "/token-estimate {SPEC}",
      "gate": { "S1": "budget", "S2": "none", "S3": "budget-cap" },
      "check": { "tool": "check-impl-lock", "args": ["-Path", "src/{IDEA}/.kcc-impl-probe"] }, "event": "estimate-issued" },
    { "id": 14, "name": "PREFLIGHT", "scope": "spec",
      "check": { "tool": "toolchain-preflight", "args": ["-Tools", "{TOOLS}"] },
      "gate": { "all": "toolchain" }, "event": "toolchain-preflight-result" },
    { "id": 15, "name": "IMPLEMENT", "scope": "wave",
      "command": "/spec-implement {SPEC} --wave {WAVE}",
      "check": { "tool": "check-wave-scope", "args": ["-Spec", "{SPEC}", "-Wave", "{WAVE}"] },
      "event": "implement-completed" },
    { "id": 16, "name": "TEST", "scope": "spec",
      "command": "/spec-test {SPEC}",
      "check": { "tool": "check-traceability", "args": ["-Spec", "{SPEC}"], "then": { "tool": "quality-gate", "args": ["-Spec", "{SPEC}"] } },
      "gate": { "all": "quality-deferred-on-exit-3" }, "event": "test-completed" },
    { "id": 17, "name": "REVIEW", "scope": "spec",
      "command": "/spec-review {SPEC}",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "review", "-Spec", "{SPEC}"], "then": { "tool": "check-run-conformance", "args": ["-Scope", "bugs", "-Spec", "{SPEC}"] } },
      "on_fail_goto": 15, "checkpoint": "spec-reviewed", "event": "review-produced" },
    { "id": 18, "name": "CLOSE", "scope": "run",
      "command": "Close the KCC run: butler-remember + memory-append for reusable knowledge, record token actuals, token-guard Mode D.",
      "check": { "tool": "check-run-conformance", "args": ["-Scope", "all"] },
      "event": "session-closed" }
  ],
  "gates": {
    "repo-bootstrap": ["init-local", "connect-remote", "skip"],
    "roi-gate": ["proceed", "revise", "abort"],
    "confirm": ["confirm", "revise", "abort"],
    "budget": ["approve", "revise", "abort"],
    "budget-cap": ["revise", "increase", "abort"],
    "windows": ["approve", "sequential", "abort"],
    "toolchain": ["install", "human-install", "defer"],
    "quality-deferred-on-exit-3": ["install", "accept-deferred", "abort"],
    "loop": ["revise", "escalate", "abort"]
  }
}
