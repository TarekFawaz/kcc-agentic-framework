flowchart TB
    subgraph Kernel["Kernel - slow, shared contracts"]
        KC[Contracts<br/>cost envelope, confidence,<br/>decision trace, agent, skill]
        KP[Protocols<br/>handover, backchannel,<br/>cells, lethal trifecta,<br/>phase model, dialects]
        KI[Inspector spec<br/>Observe -> Detect -> Propose<br/>-> Review -> Promote]
    end

    subgraph Capabilities["Capabilities - versioned reusable agents/skills, tagged L1/L2/L3"]
        Agents[Lifecycle agents<br/>interrogators, architect,<br/>spec-writer, planner,<br/>implementer, verifier]
        Skills[Skills<br/>spec-*, butler-*, token-estimate,<br/>auto, critical-human-gate,<br/>adapt-workflow]
        Meta[Meta-agents<br/>butler - token-guard<br/>always-on, fast-implementation]
    end

    Kernel --> Capabilities

    Capabilities --> A[Cell A<br/>team workflow]
    Capabilities --> B[Cell B<br/>team workflow]
    Capabilities --> D[Cell C<br/>team workflow]

    A --> T[Decision traces<br/>cost signals - confidence signals<br/>backchannel events - patterns]
    B --> T
    D --> T

    T --> I[Inspector pipeline<br/>1 Observe -> 2 Detect -> 3 Propose<br/>-> 4 Review -> 5 Promote]
    I --> Capabilities
    I --> Kernel

