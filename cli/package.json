{
  "name": "@tikasway/kcc",
  "version": "0.5.1",
  "description": "KCC command line: install, tailor, run, and serve the KCC spec-driven workflow framework.",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "pack": "bun run scripts/pack.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "dev": "bun run scripts/pack.ts && bun run src/main.ts",
    "test": "bun run scripts/pack.ts && bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
